# .env.example — Copy this file to .env and fill in your real values.
#
# NEVER commit your actual .env file to git.
# This .env.example file IS safe to commit — it has no real secrets.
#
# To use:
#   cp .env.example .env
#   Then edit .env with your real API keys.

# ── LLM Provider ──────────────────────────────────────────────────────────
# Which provider to use: "openai" or "mistral"
LLM_PROVIDER=openai

# ── OpenAI (if using GPT-4) ───────────────────────────────────────────────
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# ── Mistral (free open-source alternative) ────────────────────────────────
# Get your key from: https://console.mistral.ai/
MISTRAL_API_KEY=your-mistral-key-here

# ── Logging ───────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR
# Use DEBUG during development, INFO in production
LOG_LEVEL=INFO
