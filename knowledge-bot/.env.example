# .env.example — Copy this file to .env and fill in your real values.
#
# NEVER commit your actual .env file to git.
# This .env.example file IS safe to commit — it has no real secrets.
#
# To use:
#   cp .env.example .env
#   Then edit .env with your real API keys.

# ── LLM Provider ──────────────────────────────────────────────────────────
# Which provider to use: "openai", "mistral", or "groq"
LLM_PROVIDER=openai

# ── OpenAI (if using GPT-4 or for embeddings) ─────────────────────────────
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# ── Mistral (free open-source alternative) ────────────────────────────────
# Get your key from: https://console.mistral.ai/
MISTRAL_API_KEY=your-mistral-key-here

# ── Groq (lightning fast LPU inference, recommended for Tabular Agent) ────
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=gsk-your-groq-key-here

# ── Logging ───────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR
# Use DEBUG during development, INFO in production
LOG_LEVEL=INFO

# ── OAuth 2.0 / Corporate SSO (Pillar 8) ────────────────────────────────────
# Google Workspace — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Microsoft Entra ID (Azure AD) — https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common  # Use 'common' for multi-tenant; set to your tenant GUID for single-org

# ── Production Environment & CORS ───────────────────────────────────────────
# Comma-separated list of allowed frontend origins (e.g. for staging or production domains)
# CORS_ORIGINS=http://localhost:3000,http://192.168.1.92:3000,https://knowledge.alphalabs.nurexia.co

# ── Distributed Object Storage (S3 & MinIO) ──────────────────────────────
# STORAGE_BACKEND=local       # 'local' or 's3'
# S3_ENDPOINT_URL=http://minio:9000
# S3_PUBLIC_ENDPOINT_URL=http://localhost:9010
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET_NAME=enterprise-documents
# S3_REGION=us-east-1

# ── LLM Telemetry & Production Observability (Langfuse) ───────────────────
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com


